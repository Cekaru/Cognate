# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Upstream LLM provider (OpenAI-compatible) ---------------------------
# Phase 0 forwards /v1/* straight through to this endpoint.
PROVIDER_BASE_URL=https://api.openai.com
PROVIDER_API_KEY=sk-replace-me

# --- Postgres / pgvector -------------------------------------------------
POSTGRES_USER=polyglot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polyglot

# --- Embedding sidecar (BGE-M3) ------------------------------------------
EMBED_MODEL=BAAI/bge-m3

# --- Logging: debug | info | warn | error --------------------------------
LOG_LEVEL=info
