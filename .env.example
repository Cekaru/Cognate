# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Upstream LLM provider (OpenAI-compatible) ---------------------------
# Uncached /v1/* traffic is forwarded to this endpoint.
PROVIDER_BASE_URL=https://api.openai.com
PROVIDER_API_KEY=sk-replace-me

# --- Postgres / pgvector -------------------------------------------------
POSTGRES_USER=polyglot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polyglot

# --- Embedding sidecar (BGE-M3) ------------------------------------------
EMBED_MODEL=BAAI/bge-m3

# --- Logging: debug | info | warn | error --------------------------------
LOG_LEVEL=info

# --- Encryption at rest (optional) ---------------------------------------
# When set, L2 response bodies are encrypted with AES-256-GCM before they are
# persisted; the lookup key stays a plaintext hash so the index still works.
# Leave unset to store responses in plaintext. Must be 32 random bytes,
# base64-encoded. Generate one with:
#   openssl rand -base64 32
# Keep the real key in .env (gitignored), never here.
# POLYGLOT_ENCRYPTION_KEY=
